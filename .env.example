NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcjonalna wysylka przez Resend. Klucz API pozostaje wyłącznie na serwerze.
RESEND_API_KEY=
CRM_MAIL_FROM=
# Wlasny dlugi losowy token. Podaj go w Ustawieniach CRM na czas sesji.
CRM_MAIL_ACCESS_TOKEN=

# local: CRM w przeglądarce; sqlite: pełna edycja lokalna; cloud: Supabase
NEXT_PUBLIC_CRM_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
# Klucz publiczny anon/publishable, nigdy service_role! RLS chroni dane.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lokalny plik SQLite: uruchom npm run dev:localdb (bez kont i Supabase).
LOCAL_DATABASE_ENABLED=0
CRM_DATABASE_PATH=data/evolution.sqlite
# Odczyt WordPress / Elementor
WP_BASE_URL=
WP_USERNAME=
WP_APPLICATION_PASSWORD=
# PostHog Cloud EU/US, personal API key wyłącznie na serwerze
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Stripe: klucz ograniczony (rk_live_…) z uprawnieniem odczytu Balance i Charges
STRIPE_SECRET_KEY=
# Meta Ads: token użytkownika systemowego z uprawnieniem ads_read
META_ACCESS_TOKEN=
# Plausible Analytics: klucz Stats API (PLAUSIBLE_HOST dla self-hosted)
PLAUSIBLE_API_KEY=
PLAUSIBLE_HOST=https://plausible.io
# Alternatywa dla klucza sesyjnego wpisanego w panelu AI Brain
OPENROUTER_API_KEY=
# Lokalne CLI użytkownika, domyślnie wyłączone
LOCAL_AI_CLI_ENABLED=0

# GA4 i Google Search Console — tylko lokalne SQLite, odczyt API.
# Wybór usługi GA4 / witryny Search Console zapisujesz w Konektorach dla każdej firmy.
# Wariant A: plik JSON własnego konta usługi Google; nadaj mu dostęp do GA4/GSC.
# Zalecane miejsce: data/google-service-account.json (folder data jest ignorowany przez Git).
GOOGLE_SERVICE_ACCOUNT_FILE=
# Wariant B: własny OAuth z analytics.readonly i webmasters.readonly.
# Wypełnij wszystkie 3 zmienne, jeśli nie korzystasz z pliku konta usługi.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
