NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcjonalna wysylka przez Resend. Klucz API pozostaje wyłącznie na serwerze.
RESEND_API_KEY=
CRM_MAIL_FROM=
# Wlasny dlugi losowy token. Podaj go w Ustawieniach CRM na czas sesji.
CRM_MAIL_ACCESS_TOKEN=

# local: CRM w przeglądarce; sqlite: pełna edycja lokalna; cloud: Supabase
NEXT_PUBLIC_CRM_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
# Klucz publiczny anon/publishable, nigdy service_role! RLS chroni dane.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lokalny plik SQLite: uruchom npm run dev:localdb (bez kont i Supabase).
LOCAL_DATABASE_ENABLED=0
CRM_DATABASE_PATH=data/evolution.sqlite
# Odczyt WordPress / Elementor
WP_BASE_URL=
WP_USERNAME=
WP_APPLICATION_PASSWORD=
# PostHog Cloud EU/US, personal API key wyłącznie na serwerze
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Stripe: klucz ograniczony (rk_live_…) z uprawnieniem odczytu Balance i Charges
STRIPE_SECRET_KEY=
# Meta Ads: token użytkownika systemowego z uprawnieniem ads_read
META_ACCESS_TOKEN=
# Plausible Analytics: klucz Stats API (PLAUSIBLE_HOST dla self-hosted)
PLAUSIBLE_API_KEY=
PLAUSIBLE_HOST=https://plausible.io
# Agent AI (sekcja „Agent AI”). Klucze serwera działają tylko na localhost
# albo dla zalogowanych użytkowników Supabase; użytkownik może też podać własny klucz w panelu.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Opcjonalnie: własny endpoint zgodny z OpenAI (proxy/bramka)
OPENROUTER_BASE_URL=
OPENAI_BASE_URL=
# Lokalny model zgodny z OpenAI: Ollama http://127.0.0.1:11434/v1, LM Studio http://127.0.0.1:1234/v1
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
# Subskrypcja ChatGPT (codex login) lub Claude (Claude Code) przez lokalne CLI, domyślnie wyłączone
LOCAL_AI_CLI_ENABLED=0

# Google OAuth przez przeglądarkę — lokalne SQLite, sekrety wyłącznie na serwerze.
# Klient typu Web; dodaj URI z panelu Konektory (dokładny host i port).
# Włącz Analytics Data API, Analytics Admin API, Search Console API; opcjonalnie Google Ads API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opcjonalnie przypnij URI, np. http://localhost:3000/api/local/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Ads: token deweloperski z centrum API konta menedżera Google Ads (MCC).
# Test Account Access nie daje dostępu do kont produkcyjnych.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Wersja REST API, aktualizowana zgodnie z cyklem Google Ads.
GOOGLE_ADS_API_VERSION=v25
# Zaawansowane alternatywy: token OAuth całej instalacji (z wymaganymi scope)
# albo plik JSON konta usługi tylko dla GA4/GSC. Logowanie firmy ma pierwszeństwo.
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_FILE=
